VITE_API_BASE_URL=http://localhost:8080

# Auth
VITE_API_AUTH_ADMIN_LOGIN_PATH=/api/auth/admin/login
VITE_API_AUTH_LOGOUT_PATH=/api/auth/logout

# Shared feeds
VITE_API_ADMIN_ANNOUNCEMENTS_PATH=/api/admin/announcements
VITE_API_PUBLIC_ANNOUNCEMENTS_PATH=/api/announcements
VITE_API_NOTIFICATIONS_ME_PATH=/api/notifications/me

# Existing role endpoints (fallback sources)
VITE_API_DRIVER_MATCHES_PATH=/api/driver/matches
VITE_API_SHIPPER_MATCHES_ME_PATH=/api/shipper/matches/me
VITE_API_SHIPPER_QUOTES_PATH=/api/shipper/quotes
VITE_API_DRIVER_TRUCKS_PATH=/api/driver/trucks
VITE_API_SHIPPER_SETTLEMENTS_PATH=/api/shipper/settlements
VITE_API_DRIVER_SETTLEMENTS_PATH=/api/driver/settlements
VITE_API_SHIPPER_SETTLEMENT_CONFIRM_PATH=/api/shipper/settlements/:matchId/confirm

# Admin web aggregation endpoints (optional)
VITE_API_ADMIN_SHIPPERS_PATH=/api/admin/users/shippers
VITE_API_ADMIN_DRIVERS_PATH=/api/admin/users/drivers
VITE_API_ADMIN_DEVIATIONS_PATH=/api/admin/ops/deviations
VITE_API_ADMIN_SANCTIONS_LOGS_PATH=/api/admin/sanctions
VITE_API_ADMIN_ACTIVITY_LOGS_PATH=/api/admin/ops/activity-logs
VITE_API_ADMIN_SETTLEMENT_APPROVALS_PATH=/api/admin/settlements/approvals
VITE_API_ADMIN_SETTLEMENT_HISTORY_PATH=/api/admin/settlements/approval-history
VITE_API_ADMIN_SETTLEMENT_REVIEW_PATH=/api/admin/settlements/:settlementId/review

# Admin transport monitoring
VITE_API_ADMIN_TRANSPORT_QUOTES_PATH=/api/admin/quotes
VITE_API_ADMIN_TRANSPORT_MATCHES_PATH=/api/admin/matches
VITE_API_ADMIN_TRANSPORT_PAYMENTS_PATH=/api/admin/payments
VITE_API_ADMIN_TRANSPORT_SETTLEMENTS_PATH=/api/admin/settlements

# Admin cancellation approval
VITE_API_ADMIN_ORDER_CANCELLATION_REQUESTS_PATH=/api/admin/orders/cancellations
VITE_API_ADMIN_ORDER_CANCELLATION_REVIEW_PATH=/api/admin/orders/cancellations/:requestId/review
