# 모바일 API 서버 주소
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# 서버 연동 모드
# 0: 실서버 사용(권장)
# 1: 목업 사용
# EXPO_PUBLIC_MOCK_MODE=0

# 인증 토큰 재발급 경로(백엔드 스펙과 다르면 수정)
# EXPO_PUBLIC_AUTH_REFRESH_PATH=/auth/refresh

# 견적 생성 API 경로(옵션)
# EXPO_PUBLIC_SHIPPER_QUOTE_CREATE_PATH=/api/shipper/quotes

# 주소 선택 후 좌표 보정(Place Details/Geocoding)용 키
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# 인증 네트워크 디버그 로그(개발 환경)
# EXPO_PUBLIC_AUTH_DEBUG_LOGS=0