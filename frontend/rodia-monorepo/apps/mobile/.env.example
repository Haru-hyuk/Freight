# .env.example
# 이 파일을 복사하여 '.env.local'로 이름을 변경한 뒤, 로컬 환경에 맞게 수정하세요.

# ==========================================
# 1. Core API & Environment (핵심 서버 통신)
# ==========================================
# API 모드 (server: 실서버 통신, mock: 견적/매칭/일부 설정 화면 목업 사용)
EXPO_PUBLIC_API_MODE=server

# 인증(Auth) 목업 강제 스위치 (1: 로그인/회원가입/내정보/로그아웃 목업, 0: 실서버 호출)
# 진짜 목업 모드 권장:
# EXPO_PUBLIC_API_MODE=mock
# EXPO_PUBLIC_MOCK_AUTH=1
EXPO_PUBLIC_MOCK_AUTH=0

# API 서버 베이스 주소
# - iOS 시뮬레이터 / 웹: http://localhost:8080
# - Android 에뮬레이터: http://10.0.2.2:8080
# - 실기기 (PC와 동일한 Wi-Fi 연결 필요): http://192.168.x.x:8080
# - 외부 개발/운영 서버: http://15.x.x.x:8080
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# ==========================================
# 2. 3rd Party API Keys (외부 서비스 연동)
# ==========================================
# 구글 맵 API 키 (주소 검색, 장소 상세조회 및 좌표 변환용)
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ==========================================
# 3. OpenAPI Sync (Orval / Swagger 연동)
# ==========================================
# OpenAPI 스펙 동기화 소스 (우선순위: ORVAL_OPENAPI_SOURCE > OPENAPI_SOURCE)
# sync:api:with-orval 스크립트 및 fix-openapi-pathparams.mjs 실행 시 참조됨
# ORVAL_OPENAPI_SOURCE=http://localhost:8080/api-docs
# OPENAPI_SOURCE=http://localhost:8080/api-docs
# EXPO_PUBLIC_API_SCHEME=http
# EXPO_PUBLIC_API_PORT=8080
# ORVAL_OPENAPI_PATH=/api-docs

# ==========================================
# 4. Debug & Feature Overrides (디버그 및 경로 덮어쓰기)
# ==========================================
# 개발 환경 디버그 로그 출력 활성화 (1: 활성화, 0: 비활성화)
EXPO_PUBLIC_AUTH_DEBUG_LOGS=1
EXPO_PUBLIC_API_DEBUG_LOGS=1

# 특정 API 경로 오버라이드 (기본값 외 다른 경로 테스트 시 주석 해제)
# EXPO_PUBLIC_AUTH_REFRESH_PATH=/api/auth/refresh
# EXPO_PUBLIC_SHIPPER_QUOTE_CREATE_PATH=/api/shipper/quotes
