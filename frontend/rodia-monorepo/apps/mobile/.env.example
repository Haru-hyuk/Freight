# 모바일 API 서버 주소
#EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
#EXPO_PUBLIC_API_BASE_URL=http://192.168.10.64:8080
#EXPO_PUBLIC_API_BASE_URL=http://192.168.0.28:8080
# 서버 연동 모드
# server: 실서버 사용, mock: 목업 사용
#EXPO_PUBLIC_API_MODE=mock

# 인증 토큰 재발급 경로(백엔드 스펙과 다르면 수정)
# EXPO_PUBLIC_AUTH_REFRESH_PATH=

# 견적 생성 API 경로(옵션)
# EXPO_PUBLIC_SHIPPER_QUOTE_CREATE_PATH=/api/shipper/quotes

# 인증 네트워크 디버그 로그(개발 환경)
EXPO_PUBLIC_AUTH_DEBUG_LOGS=1
EXPO_PUBLIC_API_DEBUG_LOGS=1
