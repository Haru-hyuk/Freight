# 모바일 앱 환경변수 템플릿
# 이 파일을 .env.local로 복사해서 개인 개발 환경에 맞게 수정하세요.

# Expo 런타임 API 서버 주소(권장 기본값: localhost)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
# Android Emulator(PC localhost 접근)
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080
# 실기기(같은 Wi-Fi, PC의 LAN IP 사용)
# EXPO_PUBLIC_API_BASE_URL=http://192.168.x.x:8080
# 외부 서버
# EXPO_PUBLIC_API_BASE_URL=http://15.x.x.x:8080

# 서버 연동 모드
# server: 실서버 사용, mock: 목업 사용
EXPO_PUBLIC_API_MODE=server

# 인증 토큰 재발급 경로(비워두면 앱 기본값 /auth/refresh 사용)
EXPO_PUBLIC_AUTH_REFRESH_PATH=

# 견적 생성 API 경로(옵션)
# EXPO_PUBLIC_SHIPPER_QUOTE_CREATE_PATH=/api/shipper/quotes


# 주소 선택 후 좌표 보정(Place Details/Geocoding)용 키
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
# Orval OpenAPI source (fix-openapi-pathparams.mjs에서 사용)
# 우선순위: ORVAL_OPENAPI_SOURCE > OPENAPI_SOURCE > http://localhost:8080/api-docs
# ORVAL_OPENAPI_SOURCE=http://localhost:8080/api-docs
# OPENAPI_SOURCE=http://localhost:8080/api-docs

# sync:api:with-orval 실행 시 사용되는 옵션(필요할 때만 설정)
# EXPO_PUBLIC_API_SCHEME=http
# EXPO_PUBLIC_API_PORT=8080
# ORVAL_OPENAPI_PATH=/api-docs

# 인증/API 디버그 로그(개발 환경)
EXPO_PUBLIC_AUTH_DEBUG_LOGS=1
EXPO_PUBLIC_API_DEBUG_LOGS=1

# Google Maps API 키(실제 키로 교체)
#EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=PUT_YOUR_GOOGLE_API_KEY_HERE
