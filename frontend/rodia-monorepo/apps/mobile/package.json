{
    "name": "mobile",
    "version": "1.0.0",
    "main": "expo-router/entry",
    "scripts": {
        "sync:api": "node ./scripts/sync-expo-api-base-url.mjs",
        "sync:api:with-orval": "node ./scripts/sync-expo-api-base-url.mjs --with-orval",
        "prestart": "pnpm sync:api",
        "start": "expo start",
        "dev": "pnpm start",
        "android": "expo start --android",
        "ios": "expo start --ios",
        "web": "expo start --web",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "api:gen": "pnpm orval:gen",
        "orval:fetch": "node ./scripts/orval/fix-openapi-pathparams.mjs",
        "orval:gen": "pnpm orval:fetch && orval --config ./orval.config.js"
    },
    "dependencies": {
        "@expo/metro-runtime": "~6.1.2",
        "@react-native-async-storage/async-storage": "^2.2.0",
        "@react-native-community/datetimepicker": "8.4.4",
        "@react-navigation/elements": "^2.9.8",
        "@react-navigation/material-top-tabs": "^7.4.16",
        "@rodia/tokens": "workspace:*",
        "axios": "^1.13.4",
        "expo": "~54.0.33",
        "expo-clipboard": "~8.0.8",
        "expo-constants": "~18.0.13",
        "expo-linking": "~8.0.11",
        "expo-router": "~6.0.23",
        "expo-secure-store": "^15.0.8",
        "expo-status-bar": "~3.0.9",
        "react": "19.1.0",
        "react-dom": "19.1.0",
        "react-native": "0.81.5",
        "react-native-pager-view": "^6.9.1",
        "react-native-safe-area-context": "~5.6.2",
        "react-native-screens": "~4.16.0",
        "react-native-tab-view": "^4.2.2",
        "react-native-web": "^0.21.0",
        "react-native-webview": "13.15.0"
    },
    "devDependencies": {
        "@types/node": "^24.10.1",
        "@types/react": "~19.1.17",
        "@types/react-dom": "~19.1.0",
        "@typescript-eslint/eslint-plugin": "8.54.0",
        "@typescript-eslint/parser": "8.54.0",
        "babel-plugin-module-resolver": "^5.0.2",
        "dotenv": "^16.4.7",
        "eslint": "9.39.2",
        "orval": "8.4.1",
        "typescript": "~5.9.2"
    },
    "private": true
}
